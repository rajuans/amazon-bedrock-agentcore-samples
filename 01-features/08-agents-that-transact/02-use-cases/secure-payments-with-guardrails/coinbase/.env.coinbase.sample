# ── Secure Payment Agent — Coinbase CDP + AgentCore Payments ─────────────────
#
# ⚠️  SECURITY WARNING: this .env pattern is for LOCAL DEVELOPMENT ONLY.
# For DEPLOYED workloads, source credentials from AWS Secrets Manager or SSM
# Parameter Store — never bake secrets into images or commit them to git.
# AgentCore Payments stores provider credentials in AgentCore Identity; this
# file only holds them briefly so the setup step can register the connector.
#
# Copy to a git-ignored .env and fill in your values:
#   cp .env.coinbase.sample .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider & network ───────────────────────────────────────────────────────
CREDENTIAL_PROVIDER_TYPE=CoinbaseCDP
# ETHEREUM = Base Sepolia testnet (EVM). Fund at faucet.circle.com → Base Sepolia.
NETWORK=ETHEREUM

# ── AWS ──────────────────────────────────────────────────────────────────────
# AgentCore Payments regions: us-east-1, us-west-2, eu-central-1, ap-southeast-2
AWS_REGION=us-west-2

# ── Coinbase CDP credentials (from portal.cdp.coinbase.com) ──────────────────
# API Key ID + Secret: from project API key creation.
# Wallet Secret: from Wallet → Server Wallet. Enable "Delegated signing".
COINBASE_API_KEY_ID=<your-coinbase-api-key-id>
COINBASE_API_KEY_SECRET=<your-coinbase-api-key-secret>
COINBASE_WALLET_SECRET=<your-coinbase-wallet-secret>

# ── End-user identity ────────────────────────────────────────────────────────
# A real inbox — used to create the embedded wallet and to log into Coinbase
# WalletHub to fund it and grant delegated signing.
LINKED_EMAIL=<your-email@example.com>
USER_ID=demo-user-001

# ── Stack names (optional — provision_stack.py defaults if unset) ────────────
PAYMENT_MANAGER_NAME=SecurePaymentManager
PAYMENT_CONNECTOR_NAME=CoinbaseConnector
CREDENTIAL_PROVIDER_NAME=CoinbaseCredentialProvider

# ── Written back by the setup scripts (leave blank initially) ────────────────
# provision_stack.py writes: the 4 role ARNs, CREDENTIAL_PROVIDER_ARN,
# PAYMENT_MANAGER_ARN/ID, PAYMENT_CONNECTOR_ID.
CONTROL_PLANE_ROLE_ARN=
MANAGEMENT_ROLE_ARN=
PROCESS_PAYMENT_ROLE_ARN=
RESOURCE_RETRIEVAL_ROLE_ARN=
CREDENTIAL_PROVIDER_ARN=
PAYMENT_MANAGER_ARN=
PAYMENT_MANAGER_ID=
PAYMENT_CONNECTOR_ID=
# provision_payments.py writes:
INSTRUMENT_ID=
WALLET_ADDRESS=
SESSION_ID=

# ── Guardrail demo knobs ──────────────────────────────────────────────────────
# Session spend budget (USD) enforced server-side by AgentCore Payments.
SESSION_BUDGET_USD=1.00
# App-level per-transaction cap (USD) enforced in the agent before it pays.
PER_TX_CAP_USD=0.50
# Comma-separated merchant `to` addresses the agent is allowed to pay
# (the x402 payTo — NOT the USDC token contract).
RECIPIENT_ALLOWLIST=0xA27f7cB624B57C79d7F9de03ae9F5C705c2858dB
