# ── Secure Payment Agent — Stripe/Privy + AgentCore Payments ─────────────────
#
# ⚠️  SECURITY WARNING: this .env pattern is for LOCAL DEVELOPMENT ONLY.
# For DEPLOYED workloads, source credentials from AWS Secrets Manager or SSM
# Parameter Store — never bake secrets into images or commit them to git.
# AgentCore Payments stores provider credentials in AgentCore Identity; this
# file only holds them briefly so the setup step can register the connector.
#
# Copy to a git-ignored .env and fill in your values:
#   cp .env.privy.sample .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider & network ───────────────────────────────────────────────────────
CREDENTIAL_PROVIDER_TYPE=StripePrivy
# ETHEREUM = Base Sepolia testnet (EVM). Fund at faucet.circle.com → Base Sepolia.
NETWORK=ETHEREUM
# Base Sepolia chainId, used by the Privy policy's domain condition.
CHAIN_ID=84532

# ── AWS ──────────────────────────────────────────────────────────────────────
# AgentCore Payments regions: us-east-1, us-west-2, eu-central-1, ap-southeast-2
AWS_REGION=us-west-2

# ── Privy credentials (from dashboard.privy.io — use a DEDICATED app) ────────
# App ID + App Secret: from your Privy app settings.
# Authorization ID + Private Key: Wallet Infrastructure → Authorization → New Key
# (a P-256 key pair). Store the private key as the RAW base64 value — strip any
# "wallet-auth:" prefix Privy shows.
PRIVY_APP_ID=<your-privy-app-id>
PRIVY_APP_SECRET=<your-privy-app-secret>
PRIVY_AUTHORIZATION_ID=<your-privy-authorization-id>
PRIVY_AUTHORIZATION_PRIVATE_KEY=<your-privy-authorization-private-key-base64>
# Privy REST base (override only for a non-default environment).
PRIVY_API_BASE=https://api.privy.io
# Optional: set an owner so the app secret alone cannot edit the policy/condition
# set (production hardening; owner-authorized writes need a request signature).
PRIVY_OWNER_ID=

# ── End-user identity ────────────────────────────────────────────────────────
# A real inbox — used to create the embedded wallet and to grant delegated signing.
LINKED_EMAIL=<your-email@example.com>
USER_ID=demo-user-001

# ── Stack names (optional — provision_stack.py defaults if unset) ────────────
PAYMENT_MANAGER_NAME=SecurePaymentManagerPrivy
PAYMENT_CONNECTOR_NAME=PrivyConnector
CREDENTIAL_PROVIDER_NAME=PrivyCredentialProvider

# ── Written back by the setup scripts (leave blank initially) ────────────────
# provision_stack.py writes: the 4 role ARNs, CREDENTIAL_PROVIDER_ARN,
# PAYMENT_MANAGER_ARN/ID, PAYMENT_CONNECTOR_ID.
CONTROL_PLANE_ROLE_ARN=
MANAGEMENT_ROLE_ARN=
PROCESS_PAYMENT_ROLE_ARN=
RESOURCE_RETRIEVAL_ROLE_ARN=
CREDENTIAL_PROVIDER_ARN=
PAYMENT_MANAGER_ARN=
PAYMENT_MANAGER_ID=
PAYMENT_CONNECTOR_ID=
# provision_payments.py writes:
INSTRUMENT_ID=
WALLET_ADDRESS=
PRIVY_WALLET_ID=
SESSION_ID=
# privy_policy_setup.py writes:
PRIVY_CONDITION_SET_ID=
PRIVY_POLICY_ID=

# ── Guardrail demo knobs ──────────────────────────────────────────────────────
# Session spend budget (USD) enforced server-side by AgentCore Payments.
SESSION_BUDGET_USD=1.00
# Per-transaction cap (USD): the Privy policy `value` cap and the app-level check.
PER_TX_CAP_USD=0.50
# Comma-separated merchant `to` addresses the agent is allowed to pay
# (the x402 payTo — NOT the USDC token contract).
RECIPIENT_ALLOWLIST=0xA27f7cB624B57C79d7F9de03ae9F5C705c2858dB
